<%- include("partials/header") %>

<section
    class="movie-details"
    style="
        background-image:
        linear-gradient(
            rgba(0,0,0,.8),
            rgba(0,0,0,.95)
        ),
        url('<%= movie.backdrop_path ? backdropBase + movie.backdrop_path : "" %>');
    "
>
    <div class="movie-container">
        <div class="movie-poster">
            <% if (movie.poster_path) { %>
                <img src="<%= imageBase + movie.poster_path %>" alt="<%= movie.title %>">
            <% } %>
        </div>

        <div class="movie-content">
            <h1><%= movie.title %></h1>

            

            <div class="movie-meta">
                <span>⭐ <strong>Rating</strong> <%= Number(movie.vote_average || 0).toFixed(1) %></span>
                <span>📅 <strong>Release Date</strong> <%= movie.release_date || "N/A" %></span>
                <span>⏱️ <strong>Runtime</strong> <%= movie.runtime ? movie.runtime + " min" : "N/A" %></span>
            </div>

            <% if (movie.genres && movie.genres.length) { %>
                <div class="genres">
                    <% movie.genres.forEach(genre => { %>
                        <span><%= genre.name %></span>
                    <% }) %>
                </div>
            <% } %>
        <h2>📝 Overview</h2>
            <p><%= movie.overview || "No overview available." %></p>
            

            <div class="buttons">
                <a href="/watch/<%= movie.id %>" class="play-btn">▶ Play Movie</a>
            </div>

            <section class="provider-section">
                <h2>Where to Watch</h2>

                <% const providerGroups = [
                    { key: "watch", title: "▶ Watch", empty: "No subscription/free provider found." },
                    { key: "rent", title: "💵 Rent", empty: "No rental provider found." },
                    { key: "buy", title: "🛒 Buy", empty: "No purchase provider found." }
                ]; %>

                <% providerGroups.forEach(group => { %>
                    <div class="provider-group">
                        <h3><%= group.title %></h3>

                        <% if (providers[group.key] && providers[group.key].length) { %>
                            <div class="provider-list">
                                <% providers[group.key].forEach((provider, index) => { %>
                                    <a
                                        href="<%= provider.url %>"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="provider-btn"
                                        data-provider-url="<%= provider.url %>"
                                        data-smart-key="<%= group.key %>-<%= index %>"
                                    >
                                        <span><%= provider.name %></span>
                                        <small>Open</small>
                                    </a>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <p class="provider-empty"><%= group.empty %></p>
                        <% } %>
                    </div>
                <% }) %>
            </section>
     <section class="cast-section">

    <h2>🎭 Full Cast & Crew</h2>

    <% if (cast && cast.length) { %>

        <div class="cast-list">

            <% cast.forEach(person => { %>

                <div class="cast-card">

                    <% if (person.profile_path) { %>
                        <img
                            src="<%= imageBase + person.profile_path %>"
                            alt="<%= person.name %>"
                        >
                    <% } %>

                    <div class="cast-info">
                        <strong><%= person.name %></strong>

                        <% if (person.character) { %>
                            <small><%= person.character %></small>
                        <% } %>
                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <p class="provider-empty">
            Cast information not available.
        </p>

    <% } %>

</section>


   </div>
   </div>
   </section>
   <%- include("partials/ad") %>

<script>
(function () {
    const SMARTLINK = "https://clocksuch.com/p6zwnxxsr?key=4396b2a27117238a9343df4212c9ff84";
    const buttons = document.querySelectorAll(".provider-btn");

    buttons.forEach(function (button) {
        button.addEventListener("click", function (event) {
            const key = "fcSmartlink-" + button.dataset.smartKey;

            if (!sessionStorage.getItem(key)) {
                event.preventDefault();
                sessionStorage.setItem(key, "true");
                window.open(SMARTLINK, "_blank", "noopener,noreferrer");
            }
        });
    });
})();
</script>
<%- include("partials/footer") %>
