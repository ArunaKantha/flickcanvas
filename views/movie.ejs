<%- include("partials/header") %>

<section
    class="movie-details"
    style="
        background-image:
        linear-gradient(
            rgba(0,0,0,.8),
            rgba(0,0,0,.95)
        ),
        url('<%= backdropBase + movie.backdrop_path %>');
    "
>

    <div class="movie-container">

        <div class="movie-poster">

            <% if (movie.poster_path) { %>

                <img
                    src="<%= imageBase + movie.poster_path %>"
                    alt="<%= movie.title %>"
                >

            <% } %>

        </div>


        <div class="movie-content">

            <h1>
                <%= movie.title %>
            </h1>

            <div class="rating">

                ⭐ <%= movie.vote_average.toFixed(1) %>

            </div>

            <p>

                <%= movie.overview %>

            </p>


            <div class="movie-meta">
    <span>
        📅 <%= movie.release_date %>
    </span>

    <span>
        ⏱️ <%= movie.runtime %> min
    </span>
</div>

<div class="buttons">

    <a
        href="/watch/<%= movie.id %>"
        class="play-btn"
    >
        ▶ Play Movie
    </a>

    <% if (providerLink) { %>

    <a
        href="<%= providerLink %>"
        target="_blank"
        rel="noopener noreferrer"
        class="download-btn"
        id="watchProviderBtn"
        data-provider="<%= providerLink %>"
    >
        🔗 Watch / Rent / Buy
    </a>

    <script>
        const watchBtn = document.getElementById("watchProviderBtn");

        watchBtn.addEventListener("click", function (event) {

            // First click → Smartlink
            if (!sessionStorage.getItem("smartlinkClicked")) {
                event.preventDefault();

                sessionStorage.setItem("smartlinkClicked", "true");

                window.open(
                    "https://clocksuch.com/p6zwnxxsr?key=4396b2a27117238a9343df4212c9ff84",
                    "_blank"
                );

                return;
            }

            // Second click → original providerLink
            // Normal href continues automatically
        });
    </script>

<% } %>

</div>

</div>
</section>

<%- include("partials/ad") %>

<%- include("partials/footer") %>