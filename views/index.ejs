<%- include("partials/header") %>

<section class="hero hero-banner">

    <img
        src="/image/Firefly.png"
        alt="FLICKCANVAS"
        class="hero-banner-image"
    >

    <div class="hero-banner-overlay"></div>

    

</section>
<section class="hero-ad-space">
    <%- include("partials/ad") %>
</section>





<main id="movies">

    <% if (searchQuery) { %>

        <h2>
            Search results for:
            "<%= searchQuery %>"
        </h2>

    <% } %>


    <% if (trending && trending.length > 0) { %>

        <section class="movie-section">

            <h2>🔥 Trending Movies</h2>

            <div class="movie-grid">

                <% trending.forEach(movie => { %>

                    <a
                        href="/movie/<%= movie.id %>"
                        class="movie-card"
                    >

                        <img
                            src="<%= imageBase + movie.poster_path %>"
                            alt="<%= movie.title %>"
                        >

                        <div class="movie-info">

                            <h3>
                                <%= movie.title %>
                            </h3>

                            <span>
                                ⭐ <%= movie.vote_average.toFixed(1) %>
                            </span>

                        </div>

                    </a>

                <% }) %>

            </div>

        </section>

    <% } %>


    <section class="movie-section">

        <h2>🎬 Popular Movies</h2>

        <div class="movie-grid">

            <% popular.forEach(movie => { %>

                <a
                    href="/movie/<%= movie.id %>"
                    class="movie-card"
                >

                    <% if (movie.poster_path) { %>

                        <img
                            src="<%= imageBase + movie.poster_path %>"
                            alt="<%= movie.title %>"
                        >

                    <% } else { %>

                        <div class="no-poster">
                            No Poster
                        </div>

                    <% } %>

                    <div class="movie-info">

                        <h3>
                            <%= movie.title %>
                        </h3>

                        <span>
                            ⭐ <%= movie.vote_average.toFixed(1) %>
                        </span>

                    </div>

                </a>

            <% }) %>

        </div>

    </section>


    <% if (nowPlaying && nowPlaying.length > 0) { %>

        <section class="movie-section">

            <h2>🎥 Now Playing</h2>

            <div class="movie-grid">

                <% nowPlaying.forEach(movie => { %>

                    <a
                        href="/movie/<%= movie.id %>"
                        class="movie-card"
                    >

                        <% if (movie.poster_path) { %>

                            <img
                                src="<%= imageBase + movie.poster_path %>"
                                alt="<%= movie.title %>"
                            >

                        <% } %>

                        <div class="movie-info">

                            <h3>
                                <%= movie.title %>
                            </h3>

                            <span>
                                ⭐ <%= movie.vote_average.toFixed(1) %>
                            </span>

                        </div>

                    </a>

                <% }) %>

            </div>

        </section>

    <% } %>

</main>


<%- include("partials/footer") %>